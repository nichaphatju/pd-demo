    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxCaseSubject</name>
        <dataType>String</dataType>
        <expression>LEFT({!Issue_Type} &amp; &quot; - &quot; &amp; {!Get_Contact.Name}, 255)</expression>
    </formulas>
    <formulas>
        <name>fxEmailSubject</name>
        <dataType>String</dataType>
        <expression>{!$Label.DCC_Brand_Name} &amp; &quot; Acknowledgement – Case &quot; &amp; {!Get_New_Case.CaseNumber}</expression>
    </formulas>
    <formulas>
        <name>fxHasInvoice</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK(TRIM({!Invoice_Number})))</expression>
    </formulas>
    <formulas>
        <name>fxInvoiceNumber</name>
        <dataType>String</dataType>
        <expression>TRIM({!Invoice_Number})</expression>
    </formulas>
