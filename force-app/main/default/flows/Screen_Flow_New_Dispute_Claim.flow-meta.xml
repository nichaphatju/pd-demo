            <name>No_Account_Note</name>
            <fieldText>&lt;p&gt;&lt;em&gt;This contact is not linked to an Account. The new case will be routed to the DCC - Generic Intake queue.&lt;/em&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_Contact.AccountId</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Send_Acknowledgement</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Send acknowledgement email to customer</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Sends the standard acknowledgement email with the case number to the contact&apos;s email address.&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_Contact.Email</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>No_Email_Note</name>
            <fieldText>&lt;p&gt;&lt;em&gt;This contact has no email address, so an acknowledgement email cannot be sent.&lt;/em&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_Contact.Email</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Duplicate_Warning</name>
        <label>Possible Duplicate Invoice</label>
        <locationX>50</locationX>
        <locationY>834</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_SLA_Mapping</targetReference>
        </connector>
        <fields>
            <name>Duplicate_Warning_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Possible duplicate:&lt;/strong&gt; invoice number &lt;strong&gt;{!fxInvoiceNumber}&lt;/strong&gt; is already recorded against another case.&lt;/p&gt;&lt;p&gt;Click Next to create the case anyway, or Back to change the invoice number.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Email_Failed</name>
        <label>Acknowledgement Not Sent</label>
        <locationX>400</locationX>
        <locationY>1934</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Email_Failed_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Case {!Get_New_Case.CaseNumber} has been created&lt;/strong&gt;, but the acknowledgement email could not be sent.&lt;/p&gt;&lt;p&gt;Details: {!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;/{!varCase.Id}&quot; target=&quot;_parent&quot;&gt;Open Case&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Error</name>
        <label>Something Went Wrong</label>
        <locationX>600</locationX>
        <locationY>1034</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Sorry, the case could not be created.&lt;/strong&gt; Please try again or contact your Salesforce administrator.&lt;/p&gt;&lt;p&gt;Details: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Invoice</name>
        <label>Invoice (Optional)</label>
        <locationX>176</locationX>
        <locationY>434</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_Has_Invoice</targetReference>
        </connector>
        <fields>
            <name>Progress_Invoice</name>
            <fieldText>&lt;p&gt;Customer  ›  Case Details  ›  &lt;strong&gt;Step 3 of 3: Invoice (Optional)&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Intro_Invoice</name>
            <fieldText>&lt;p&gt;If the customer has quoted an invoice, enter it here. It will be recorded as the primary invoice for the case. You can add more invoices on the case later.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Invoice_Number</name>
            <dataType>String</dataType>
            <fieldText>Invoice Number</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Invoice reference exactly as shown on the customer&apos;s invoice. Leave blank if not known.&lt;/p&gt;</helpText>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Invoice_Amount</name>
            <dataType>Currency</dataType>
            <fieldText>Invoice Amount</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Total amount of the invoice, if known.&lt;/p&gt;</helpText>
            <isRequired>false</isRequired>
            <scale>2</scale>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttAcknowledgementEmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear {!Get_Contact.FirstName},

We acknowledge receipt of your enquiry. Your case has been logged under reference number {!Get_New_Case.CaseNumber}.

Our team will review the details and investigate the matter. We will keep you informed of progress as the case is assessed.

Please note this is an automated message and this mailbox is not monitored. If you have any questions or additional information to provide, please contact your Account Manager directly.

Kind regards,
{!$Label.DCC_Brand_Name} Team</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
