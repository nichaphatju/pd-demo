<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Invoice Number</label>
    <pluralLabel>Invoice Numbers</pluralLabel>
    <description>Captures one or more invoice references against a DCC Case. One record per Case is designated as the Primary Invoice.</description>
    <sharingModel>ControlledByParent</sharingModel>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <deploymentStatus>Deployed</deploymentStatus>
    <visibility>Public</visibility>
    <nameField>
        <label>Record Name</label>
        <type>AutoNumber</type>
        <displayFormat>INV-{000000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
</CustomObject>
